{
  "manifest_version": 3,
  "name": "Text Saver",
  "version": "1.1",
  "description": "Save and manage multi-line text notes.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
